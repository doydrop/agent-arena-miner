# Copy this file to .env and fill it in when your Delphi API key exists.
# The key page opens 26 Nov 2026, 00:00 WIB (25 Nov 2026, 17:00 UTC):
# https://api-access.delphi.fyi/
#
# Never share .env. The program does not print this key.

# Official name used by @gensyn-ai/gensyn-delphi-sdk. DELPHI_API_KEY still works if this is empty.
DELPHI_API_ACCESS_KEY=

# Evidence API base, including /v1. Change this if the published guide uses another host.
# ASSUMPTION: mainnet, because the key page above issues mainnet keys. See docs/ADAPTING.md.
DELPHI_API_URL=https://api.delphi.fyi/v1

# Competition site that serves /markets.json. Leave empty until the official starter names it.
# With this empty, and with no API key, the program uses the built-in sample markets.
COMPETITION_SITE_URL=

# Sent as X-Agent-Id, X-Agent-Harness, and X-Agent-Model.
AGENT_ID=evidence-miner
AGENT_HARNESS=evidence-mining-agent
AGENT_MODEL=
AGENT_OWNER=POCONG

# After you open the terms URL the program prints, put that exact version here.
# The program accepts the terms only when this matches. It does not accept them by itself.
ACCEPT_TERMS=

# One-page PDF attached to each draft. It counts toward the 3-file limit.
# Set to false to stop generating it.
ATTACH_EVIDENCE_PDF=true

# Optional. The researcher works with these empty. Any OpenAI-compatible chat API.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional. The SDK has no feedback route as of 2.4.0. If Delphi publishes one, put it here.
DELPHI_FEEDBACK_URL=

# Local dashboard. It binds to 127.0.0.1 only.
PORT=3737
DATA_DIR=data
